# env — .env.example is the ONLY env file that may be committed.
# Deny-all-then-allow, so a stray .env.bak / .env.save / .env.2 cannot be
# swept in by `git add -A`. That has already happened once in this repo.
.env*
!.env.example

node_modules/
.pnpm-store/

.next/
out/
build/
dist/

coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# NOTE: src/styles/tokens.css and src/lib/theme/types.ts are GENERATED but ARE
# committed — the S2b CI staleness check regenerates and diffs against them.
# Never hand-edit either; run pnpm tokens:build.

*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.tsbuildinfo

# nvm
.node-version
