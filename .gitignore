# env — .env.example is the ONLY env file that may be committed.
# Deny-all-then-allow, so a stray .env.bak / .env.save / .env.2 cannot be
# swept in by `git add -A`. That has already happened once in this repo.
.env*
!.env.example

node_modules/
.pnpm-store/

.next/
.next-*/
out/
build/
dist/

coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# `pnpm quality` caches its last results here so the page is useful the moment
# it opens. Machine-local and re-derivable — never committed.
.quality/

# Written by `pnpm demo:reset` for the e2e suite. Holds live QR codes for
# whichever database was last seeded — never commit it.
.demo-seed.json

*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.tsbuildinfo

# nvm
.node-version

# derived from the design export by `pnpm design:decode`
design/reference/decoded/

# The React Native app's build output and native projects. `mobile/` has its
# own lockfile (committed) and its own node_modules (not).
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/ios/
mobile/android/

# The Expo access token, for non-interactive `eas build`. Kept in a file rather
# than pasted into a terminal so it never lands in a transcript or a shell
# history, and ignored here so it can never land in a commit. It is a
# credential for the account that signs and publishes the app.
.eas-token
mobile/.eas-token
