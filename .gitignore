# env — .env.example is the ONLY env file that may be committed.
# Deny-all-then-allow, so a stray .env.bak / .env.save / .env.2 cannot be
# swept in by `git add -A`. That has already happened once in this repo.
.env*
!.env.example

node_modules/
.pnpm-store/

.next/
out/
build/
dist/

coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Written by `pnpm demo:reset` for the e2e suite. Holds live QR codes for
# whichever database was last seeded — never commit it.
.demo-seed.json

*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.tsbuildinfo

