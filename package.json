{
  "name": "hotel-guest-services",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "tsx scripts/dev-lan.ts",
    "build": "next build && pnpm bundle:static",
    "start": "node ${NEXT_DIST_DIR:-.next}/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-roles.ts",
    "db:studio": "drizzle-kit studio",
    "demo:reset": "tsx --env-file-if-exists=.env scripts/demo-reset.ts",
    "logo:build": "tsx scripts/prepare-logo.ts",
    "status": "tsx scripts/status.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "design:decode": "tsx scripts/decode-design-export.ts",
    "bundle:static": "D=${NEXT_DIST_DIR:-.next}; rm -rf $D/standalone/$D/static $D/standalone/public && cp -r $D/static $D/standalone/$D/static && cp -r public $D/standalone/public 2>/dev/null || true"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "^15.5.24",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
