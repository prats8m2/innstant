# Where the API is, for `expo start`.
#
# There is no value that is right for every target, which is why this is
# configuration rather than a constant:
#
#   iOS simulator      http://localhost:3000
#   Android emulator   http://10.0.2.2:3000     (the host, from inside the VM)
#   A real phone       http://<your-lan-ip>:3000
#
# `pnpm dev:lan` in the web app prints the third one — it is the same address a
# QR code has to carry for a phone to reach a laptop, and the same reason that
# script exists.
EXPO_PUBLIC_API_URL=http://localhost:3000
