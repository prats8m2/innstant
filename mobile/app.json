{
  "expo": {
    "name": "The Kesari",
    "slug": "kesari-order",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kesari",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.innstant.kesari.order",
      "associatedDomains": [
        "applinks:innstant.in"
      ]
    },
    "android": {
      "package": "in.innstant.kesari.order",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "innstant.in",
              "pathPrefix": "/p"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the code on your table to see the menu."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31795b06-72ad-4956-9c4d-5488da2cc60f"
      }
    },
    "owner": "prats8m"
  }
}
