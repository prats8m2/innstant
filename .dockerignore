# Keep the build context small and keep secrets out of it. Anything listed
# here is invisible to `docker build` — including .env, which must never enter
# an image layer.
.env*
!.env.example
.demo-seed.json

node_modules
.next
out
build
dist

.git
.github
.claude

coverage
test-results
playwright-report
blob-report
tests

docs
design
*.md
!README.md

*.log
.DS_Store
.idea
.vscode
*.tsbuildinfo

# The logo masters — 8.7MB of 3482×1184 PNG that nothing imports. The web
# assets beside them (innstant-lockup-*.png, innstant-mark-dark.png) ARE
# imported and must stay. `pnpm logo:build` regenerates those from these, and
# that runs on a developer's machine, never in the image.
src/app/images/innstant_logo_*.png

# The React Native app (D-080). A separate package with its own lockfile and
# its own toolchain, built by EAS rather than by this Dockerfile, and nothing
# in the Next.js server imports a line of it.
mobile/
