# ── Database ────────────────────────────────────────────────────────────────
# App connection. MUST be the app_user role, not the owner — see CLAUDE.md #2.
# MUST point at the pooler in TRANSACTION mode — see CLAUDE.md #3.
DATABASE_URL="postgresql://app_user:...@...:6543/railway"
# Owner role, used only by pnpm db:migrate.
DATABASE_MIGRATION_URL="postgresql://postgres:...@...:5432/railway"

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
SESSION_SECRET=""                 # 32+ random bytes

# ── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hotel-media"
R2_PUBLIC_URL=""

# ── Payments (Razorpay — test keys until pilot) ─────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Messaging (OTP + staff alerts) ──────────────────────────────────────────
SMS_PROVIDER_KEY=""
WHATSAPP_PROVIDER_KEY=""

# ── Maps ────────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=""
