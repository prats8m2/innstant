# ── Database ────────────────────────────────────────────────────────────────
# TWO connections, on purpose. No PgBouncer — see D-022.
#
# Locally these are Railway's public TCP proxy (*.proxy.rlwy.net), which uses a
# RANDOM HIGH PORT that maps to Postgres's internal 5432 — the port shown in the
# Railway UI is the internal one and will not work from a laptop. Deployed on
# Railway, prefer the private network: postgres.railway.internal:5432.

# The app. app_user owns no tables and lacks BYPASSRLS, which is the only reason
# the RLS policies are load-bearing rather than decorative (CLAUDE.md #2).
# Pooling is node-postgres inside our own process; withTenant() sets the tenant
# context with set_config(..., true) inside a transaction, never a bare SET,
# because the pool reuses connections across requests (CLAUDE.md #3).
DATABASE_URL="postgresql://app_user:...@<host>.proxy.rlwy.net:<port>/railway"

# Migrations only, run by `pnpm db:migrate`. The OWNER role — app_user cannot
# create tables, and pointing the APP at this role would silently disable RLS.
DATABASE_MIGRATION_URL="postgresql://postgres:...@<host>.proxy.rlwy.net:<port>/railway"

# Optional tuning.
# DATABASE_POOL_MAX="10"
# DATABASE_STATEMENT_TIMEOUT_MS="15000"

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
SESSION_SECRET=""                 # 32+ random bytes

# ── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hotel-media"
R2_PUBLIC_URL=""

# ── Payments (Razorpay — test keys until pilot) ─────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Messaging (OTP + staff alerts) ──────────────────────────────────────────
SMS_PROVIDER_KEY=""
WHATSAPP_PROVIDER_KEY=""

# ── Maps ────────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=""
