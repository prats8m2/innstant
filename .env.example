# ── Database ────────────────────────────────────────────────────────────────
# THREE connections, on purpose. Each exists because the other two cannot do
# its job. Getting these wrong is silent, not loud.
#
#  1. DATABASE_URL         app queries    -> PgBouncer, TRANSACTION mode, app_user
#  2. DATABASE_MIGRATION_URL  migrations  -> DIRECT to Postgres, owner role
#  3. DATABASE_LISTEN_URL   LISTEN/NOTIFY -> DIRECT to Postgres, app_user
#
# Locally, "direct" and "pooled" are two different Railway TCP-proxy host:port
# pairs. Deployed on Railway, prefer the private network — postgres.railway.internal:5432
# and pgbouncer.railway.internal:6432 — which is faster and not publicly exposed.

# 1. Every request-path query. app_user (owns nothing, no BYPASSRLS — CLAUDE.md #2)
#    through PgBouncer in TRANSACTION pooling mode (CLAUDE.md #3). withTenant()
#    uses set_config(..., true) inside an explicit transaction, which is exactly
#    what transaction pooling supports. A bare SET would leak between requests.
DATABASE_URL="postgresql://app_user:...@<pgbouncer-host>:6432/railway"

# 2. Migrations only, run by `pnpm db:migrate`. The OWNER role, and DIRECT —
#    never through the pooler. DDL, advisory locks and the RLS verification
#    block in 0001 all want one uninterrupted session.
DATABASE_MIGRATION_URL="postgresql://postgres:...@<postgres-host>:5432/railway"

# 3. The realtime listener. D-015 is Postgres LISTEN/NOTIFY -> SSE, and
#    **LISTEN/NOTIFY DOES NOT WORK THROUGH PGBOUNCER IN TRANSACTION MODE** — the
#    server connection is handed to another client the moment the transaction
#    ends, so the LISTEN registration is lost and notifications are delivered to
#    whoever happens to hold that connection, or to nobody.
#    This one long-lived connection bypasses the pooler. It is a single session
#    for the whole process, not per request. app_user, same as the app.
DATABASE_LISTEN_URL="postgresql://app_user:...@<postgres-host>:5432/railway"

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
SESSION_SECRET=""                 # 32+ random bytes

# ── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hotel-media"
R2_PUBLIC_URL=""

# ── Payments (Razorpay — test keys until pilot) ─────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Messaging (OTP + staff alerts) ──────────────────────────────────────────
SMS_PROVIDER_KEY=""
WHATSAPP_PROVIDER_KEY=""

# ── Maps ────────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=""
