# ── Database ────────────────────────────────────────────────────────────────
# TWO connections, on purpose. No PgBouncer — see D-022.
#
# Locally these are Railway's public TCP proxy (*.proxy.rlwy.net), which uses a
# RANDOM HIGH PORT that maps to Postgres's internal 5432 — the port shown in the
# Railway UI is the internal one and will not work from a laptop. Deployed on
# Railway, prefer the private network: postgres.railway.internal:5432.

# The app. app_user owns no tables and lacks BYPASSRLS, which is the only reason
# the RLS policies are load-bearing rather than decorative (CLAUDE.md #2).
# Pooling is node-postgres inside our own process; withTenant() sets the tenant
# context with set_config(..., true) inside a transaction, never a bare SET,
# because the pool reuses connections across requests (CLAUDE.md #3).
DATABASE_URL="postgresql://app_user:...@<host>.proxy.rlwy.net:<port>/railway"

# Migrations only, run by `pnpm db:migrate`. The OWNER role — app_user cannot
# create tables, and pointing the APP at this role would silently disable RLS.
DATABASE_MIGRATION_URL="postgresql://postgres:...@<host>.proxy.rlwy.net:<port>/railway"

# TLS is decided from the host: a remote host gets it, localhost does not, and
# `?sslmode=disable` forces it off (src/db/ssl.ts). A local Postgres — or the
# service container in CI — needs no flag; a remote one that somehow speaks no
# TLS needs `?sslmode=disable` in the URL.
#
# Running against a local Postgres instead of the shared Railway database:
#   DATABASE_URL="postgresql://app_user:app_user@localhost:5432/guest_services"
#   DATABASE_MIGRATION_URL="postgresql://postgres:postgres@localhost:5432/guest_services"
#   pnpm db:bootstrap && pnpm db:migrate && pnpm demo:reset

# Optional tuning.
# DATABASE_POOL_MAX="10"
# DATABASE_STATEMENT_TIMEOUT_MS="15000"

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
# Every guest QR link is built from APP_URL and NEVER from the incoming request
# (standalone binds 0.0.0.0, so a request-derived URL behind a proxy is an
# internal hostname). That means `localhost` here is right for this machine and
# useless on a phone: it resolves to the phone.
#
# To demo on real hardware over wifi, do NOT edit this — run `pnpm dev:lan`,
# which resolves the LAN address at startup and passes it to the dev server for
# the life of the process. The address changes when you join a different
# network, so a value pinned in this file goes stale silently.
SESSION_SECRET=""                 # 32+ random bytes

# Which tenant the staff login form signs in to.
#
# A STOPGAP for the single-tenant demo, and a deliberate one — how a browser
# establishes its tenant is part of the tenancy model (CLAUDE.md), so the login
# refuses to guess rather than signing someone in to the wrong hotel. The two
# real answers are a subdomain, or an email → tenant lookup through a SECURITY
# DEFINER function like resolve_qr_routing(). See the note in
# src/app/(admin)/admin/login/actions.ts.
#
# `pnpm demo:reset` prints this; it is fixed for the demo tenant.
STAFF_TENANT_ID="deadbeef-0000-4000-8000-000000000001"

# Pino level. Defaults to debug in development, info in production.
# LOG_LEVEL="info"

# Set by Railway on every deploy — do not set it by hand. It is what ties a log
# line and /api/health back to a commit.
# RAILWAY_GIT_COMMIT_SHA=""

# ── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hotel-media"
R2_PUBLIC_URL=""

# ── Payments (Razorpay — test keys until pilot) ─────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Messaging (OTP + staff alerts) ──────────────────────────────────────────
SMS_PROVIDER_KEY=""
WHATSAPP_PROVIDER_KEY=""

# ── Maps ────────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=""

# Demo only. When set, EVERY sign-in uses this exact code for EVERY number —
# anyone who knows a phone number can sign in as that person. It exists so the
# app can be demonstrated before an SMS provider is wired, it is announced in
# the log on every send, and it is deleted the day a real OtpSender lands.
# Leave UNSET unless you are running a demo.
OTP_DEMO_CODE=
